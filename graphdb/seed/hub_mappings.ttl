hub:MAP_SENSOR_84E27ABD a hub:ConceptMapping ;
    hub:confidence "high" ;
    hub:mappingSource "semi-automatic" ;
    hub:relation skos:exactMatch ;
    hub:sourceConcept hub:HC_SENSOR ;
