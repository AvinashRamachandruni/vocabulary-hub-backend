    hub:confidence "high" ;
    hub:mappingSource "semi-automatic" ;
    hub:relation skos:exactMatch ;
    hub:sourceConcept hub:HC_OBSERVATION ;
    hub:targetTerm sosa:Observation ;
    hub:validationStatus "validated" ;
