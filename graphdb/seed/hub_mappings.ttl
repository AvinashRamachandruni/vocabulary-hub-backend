hub:HC_OBSERVATION a skos:Concept ;
    skos:exactMatch sosa:Observation ;
    skos:prefLabel "observation"@en .

hub:HC_SENSOR a skos:Concept ;
    skos:exactMatch sosa:Sensor,
        brick:Sensor,
        ifc:IfcSensor ;
    skos:prefLabel "sensor"@en .

hub:HC_BUILDING a skos:Concept ;
    skos:exactMatch brick:Building,
        ifc:IfcBuilding,
        bot:Building,
        <https://w3id.org/rec#Building> ;
    skos:prefLabel "building"@en .

