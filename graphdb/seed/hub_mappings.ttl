@prefix bot: <https://w3id.org/bot#> .
@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix hub: <http://example.org/vocab-hub#> .
@prefix ifc: <https://standards.buildingsmart.org/IFC/DEV/IFC4/ADD2_TC1/OWL#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

hub:HC001 a skos:Concept ;
    skos:altLabel "area"@en,
        "room"@en,
        "zone"@en ;
    skos:definition "A spatial entity or area used to represent rooms, zones, or other bounded spaces across semantic resources."@en ;
    skos:exactMatch brick:Space,
        ifc:IfcSpace,
        bot:Space ;
    skos:prefLabel "space"@en ;
    skos:relatedMatch brick:Room .

hub:MAP_BUILDING_30206374 a hub:ConceptMapping ;
    hub:confidence "high" ;
    hub:mappingSource "semi-automatic" ;
    hub:relation skos:exactMatch ;
    hub:sourceConcept hub:HC_BUILDING ;
    hub:targetTerm bot:Building ;
    hub:validationStatus "draft" ;
    dcterms:created "2026-05-07"^^xsd:date .

