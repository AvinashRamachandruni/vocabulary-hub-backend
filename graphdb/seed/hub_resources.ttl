<http://example.org/vocab-hub#RES001> a <http://example.org/vocab-hub#SemanticResource>;
  <http://purl.org/dc/terms/title> "Building Topology Ontology";
  <http://purl.org/dc/terms/description> "An ontology for describing the topological structure of buildings and spaces.";
  <http://purl.org/dc/terms/publisher> "W3C Linked Building Data Community Group";
  <http://example.org/vocab-hub#resourceType> "ontology";
  <http://example.org/vocab-hub#accessLevel> "public";
  <http://example.org/vocab-hub#namespaceURI> "https://w3id.org/bot#";
  <http://example.org/vocab-hub#resourceFormat> "ttl";
  <http://example.org/vocab-hub#availability> "uri";
  <http://example.org/vocab-hub#sourceURI> <https://w3id.org/bot>;
  <http://example.org/vocab-hub#domainTag> "building topology";
  <http://example.org/vocab-hub#graphURI> "http://example.org/graph/ontology/bot" .

